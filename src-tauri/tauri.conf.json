{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Launcher",
  "version": "0.2.0",
  "identifier": "ai.deepseek.dsh-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "control",
        "title": "DSH Launcher",
        "width": 880,
        "height": 760,
        "minWidth": 620,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com; connect-src ipc: http://ipc.localhost; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Desktop launcher for DeepSeek Harness",
    "longDescription": "Starts and manages dsh web in a native desktop window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
